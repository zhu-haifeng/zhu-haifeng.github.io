<div class="reading-progress" aria-hidden="true"><span></span></div>

<dialog class="image-lightbox" aria-label="图片预览">
  <button class="lightbox-close" type="button" aria-label="关闭图片预览" title="关闭">×</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  const progress = document.querySelector<HTMLElement>('.reading-progress span');
  const content = document.querySelector<HTMLElement>('.post-content');
  const dialog = document.querySelector<HTMLDialogElement>('.image-lightbox');
  const dialogImage = dialog?.querySelector<HTMLImageElement>('img');
  const caption = dialog?.querySelector<HTMLElement>('figcaption');
  const close = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');

  const updateProgress = () => {
    if (!progress || !content) return;
    const top = content.getBoundingClientRect().top + window.scrollY;
    const span = Math.max(content.offsetHeight - window.innerHeight, 1);
    const value = Math.min(1, Math.max(0, (window.scrollY - top) / span));
    progress.style.transform = `scaleX(${value})`;
  };

  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  if (content && dialog && dialogImage && caption && close) {
    const images = [...content.querySelectorAll<HTMLImageElement>('img')];
    images.forEach((image) => {
      image.classList.add('lightbox-trigger');
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `放大查看：${image.alt || '图片'}`);

      const open = () => {
        dialogImage.src = image.currentSrc || image.src;
        dialogImage.alt = image.alt;
        caption.textContent = image.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || image.alt;
        dialog.showModal();
      };

      image.addEventListener('click', open);
      image.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });

    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.post-toc a[href^="#"]')];
  const sections = tocLinks
    .map((link) => ({ link, section: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
    .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section !== null);

  if (sections.length) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      sections.forEach(({ link, section }) => link.classList.toggle('active', section === visible.target));
    }, { rootMargin: '-20% 0px -68% 0px', threshold: 0 });
    sections.forEach(({ section }) => observer.observe(section));
  }
</script>
