---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/#articles', label: '文章' },
  { href: '/drama/', label: '话剧社' },
  { href: '/changelog/', label: '更新日志' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Joseph 首页">
      <span class="wordmark-seal" aria-hidden="true">山</span>
      <span>Joseph</span>
    </a>
    <nav aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={{ active: link.href !== '/#articles' && currentPath === link.href }}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
