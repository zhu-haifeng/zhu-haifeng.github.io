---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/#articles', label: '文章' },
  { href: '/drama/', label: '话剧社' },
  { href: '/changelog/', label: '更新日志' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Joseph 首页">
      <span class="wordmark-seal" aria-hidden="true">山</span>
      <span>Joseph</span>
    </a>
    <nav aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={{ active: link.href !== '/#articles' && currentPath === link.href }}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="切换夜间模式" title="切换夜间模式">
      <span class="theme-toggle-icon" aria-hidden="true">☾</span>
      <span class="theme-toggle-label">夜间</span>
    </button>
  </div>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const themeIcon = themeToggle?.querySelector<HTMLElement>('.theme-toggle-icon');
  const themeLabel = themeToggle?.querySelector<HTMLElement>('.theme-toggle-label');

  const updateThemeButton = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (themeIcon) themeIcon.textContent = dark ? '☀' : '☾';
    if (themeLabel) themeLabel.textContent = dark ? '日间' : '夜间';
    themeToggle?.setAttribute('aria-label', dark ? '切换日间模式' : '切换夜间模式');
    themeToggle?.setAttribute('title', dark ? '切换日间模式' : '切换夜间模式');
  };

  updateThemeButton();
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('joseph-theme', next);
    updateThemeButton();
  });
</script>
