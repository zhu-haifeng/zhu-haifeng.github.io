---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleEnhancements from '../components/ArticleEnhancements.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = 'Joseph',
  description = '旅行、城市与途中所想。',
  image = '/images/beijing/dji_export_photo_20260729172202543_1785318125515edit.jpg',
  imageWidth,
  imageHeight,
  imageAlt,
  article = false,
  publishedTime,
  modifiedTime,
} = Astro.props;
const pageTitle = title === 'Joseph' ? title : `${title}｜Joseph`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Joseph" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Joseph" />
    <meta property="og:locale" content="zh_CN" />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f5f6f4" />
    <script is:inline>
      const savedTheme = localStorage.getItem('joseph-theme');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = savedTheme || systemTheme;
    </script>
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <Header />
    <main>
      <slot />
    </main>
    {article && <ArticleEnhancements />}
    <Footer />
    <a class="back-top" href="#top" aria-label="返回顶部" title="返回顶部">↑</a>
  </body>
</html>
