---
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  cover: string;
  section?: string;
  tocDepth?: 2 | 3;
  headings?: Heading[];
  tags?: string[];
}

const { title, description, publishedAt, updatedAt, cover, section = '随笔', tocDepth = 3, headings = [], tags = [] } = Astro.props;
const sectionHref = section === '舞台记录' ? '/drama/' : '/#articles';
const dateFormatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const toc = headings.filter((heading) => heading.depth === 2 || (tocDepth === 3 && heading.depth === 3));
---

<BaseLayout title={title} description={description} image={cover} article>
  <article class="post-shell">
    <header class="post-header">
      <a class="post-kicker" href={sectionHref}>{section}</a>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <time datetime={publishedAt.toISOString()}>{dateFormatter.format(publishedAt)}</time>
        {updatedAt && <span>更新于 {dateFormatter.format(updatedAt)}</span>}
        <span>约 12 分钟阅读</span>
      </div>
      {tags.length > 0 && (
        <div class="tag-list" aria-label="文章标签">
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    <div class="post-grid">
      {toc.length > 0 && (
        <aside class="post-toc" aria-label="文章目录">
          <p>本文目录</p>
          <nav>
            {toc.map((heading) => (
              <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
      <div class="post-content">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
