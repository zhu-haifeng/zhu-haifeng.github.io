---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getCollection('posts', ({ data }) => !data.draft);

const toRelated = (candidate: (typeof posts)[number]) => ({
  id: candidate.id,
  title: candidate.data.title,
  description: candidate.data.description,
  cover: candidate.data.cover,
  coverAlt: candidate.data.coverAlt,
  sharedTags: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)),
});

const relatedPosts = post.data.related
  ? post.data.related
      .map((id) => posts.find((candidate) => candidate.id === id))
      .filter((candidate): candidate is (typeof posts)[number] => Boolean(candidate))
      .map(toRelated)
  : posts
      .filter((candidate) => candidate.id !== post.id)
      .map(toRelated)
      .filter((candidate) => candidate.sharedTags.length > 0)
      .sort((a, b) => b.sharedTags.length - a.sharedTags.length)
      .slice(0, 3);

const { related: _related, ...postData } = post.data;
---

<PostLayout {...postData} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</PostLayout>
